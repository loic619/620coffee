{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/loic619/620coffee/main/schemas/catalog.schema.json",
  "title": "620coffee catalogue",
  "description": "Index of every dataset published by this repository. See docs/DATA_CONTRACT.md.",
  "type": "object",
  "required": ["catalog_version", "generated_at", "datasets"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "integer",
      "const": 1,
      "description": "Bumped only on a breaking change to this shape."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the catalogue was last rendered."
    },
    "datasets": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataset" }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "required": ["id", "title", "source", "path", "format", "bytes", "sha256", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+){1,3}$",
          "description": "Permanent identifier, <source>.<family>[.<variant>]. Never reused."
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "description": "Upstream publisher key; matches data/<source>/ and docs/SOURCES.md."
        },
        "path": {
          "type": "string",
          "pattern": "^data/[a-z0-9]+/[a-z0-9_.-]+$",
          "description": "Repository-relative path to the dataset file."
        },
        "format": { "type": "string", "enum": ["json"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this dataset's content last changed."
        },
        "cadence": {
          "type": "string",
          "enum": ["intraday", "daily", "weekly", "monthly", "quarterly", "irregular", "static"]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "schema": {
          "type": "string",
          "pattern": "^schemas/[a-z0-9_.-]+\\.json$"
        },
        "upstream": { "type": "string", "format": "uri" },
        "deprecated": { "type": "boolean", "default": false }
      }
    }
  }
}
